     Set-Cell $ws 1 1 'ID'
     Set-Cell $ws 1 2 'TAG'
     Set-Cell $ws 2 1 111111
     Set-Cell $ws 2 2 'show'
     Set-Cell $ws 3 1 222222          # last data row -- will be hidden by the filter
