diff --git a/TenantConfig.vb b/TenantConfig.vb
index 2fc9c84..3524d45 100644
--- a/TenantConfig.vb
+++ b/TenantConfig.vb
@@ -113,20 +113,29 @@ Public Function TenantColLetter(ByVal concept As String) As String
         Case "blocker-name":            TenantColLetter = "AG"
         ' This tracker joins its rows to Coupa requisitions on the submitted invoice #, which the
         ' supplier provides. Declared explicitly so core does not have to fall back.
         Case "req-join-key":            TenantColLetter = "O"
         Case Else
             Err.Raise 5, "TenantColLetter", _
                 "Unknown column concept '" & concept & "'. Add it to TenantConfig."
     End Select
 End Function
 
+' Identifier concepts NormalizeIdentifierColumns sweeps to text on every Refresh, the same way
+' ConvertStoreNumbers zero-pads STORE #. purchase-order-number (U) is deliberately not listed:
+' it is a pure formula column here (see WriteFormulas_Tracker.vb), and NormalizeIdentifierColumnsOn
+' skips formula cells outright, so listing it would do nothing but invite confusion later.
+Public Function TenantIdentifierColumns() As Variant
+    TenantIdentifierColumns = Array("submitted-invoice-number", "coupa-invoice-number", _
+                                    "requisition-number", "payment-number")
+End Function
+
 ' Converts the letter to a column index without depending on the active sheet.
 Public Function TenantCol(ByVal concept As String) As Long
     Dim letters As String
     Dim i As Long
     Dim result As Long
 
     letters = UCase$(TenantColLetter(concept))
     For i = 1 To Len(letters)
         result = result * 26 + (Asc(Mid$(letters, i, 1)) - 64)
     Next i
